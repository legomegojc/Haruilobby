{
  "rules": {
    "feliceRooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null",
        "state": {
          ".validate": "newData.hasChildren(['alphaName', 'alphaScore', 'betaName', 'betaScore', 'round', 'game'])",
          "alphaName": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "alphaScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "betaName": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "betaScore": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "game": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "$other": { ".validate": false }
  }
}
